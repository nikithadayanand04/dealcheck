# Copy to backend/.env and fill in. Never commit backend/.env.
# Leave unset to use SQLite at data/dealcheck.db. For production:
# DATABASE_URL=postgresql://user:password@host:5432/dealcheck
# Create with: python -m backend.set_admin_password
ADMIN_PASSWORD_HASH=
# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGIN=http://localhost:5173
RATE_LIMIT=30/minute
